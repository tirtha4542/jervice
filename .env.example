APP_NAME=Tavonza AI
APP_ENV=development
# Must use the asyncpg driver (postgresql+asyncpg://). A bare postgresql:// URL
# would require psycopg2, which is not installed in this project.
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/tavonza_local
GROQ_API_KEY=your_groq_api_key_here
# Must be a model your Groq key can access: https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
JARVIS_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Local authentication and route-only AI integration
# ---------------------------------------------------------------------------
# Generate a long random value for JWT_SECRET. Required for any shared profile.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ISSUER=tavonza-ai
JWT_AUDIENCE=tavonza-api
DEV_AUTH_TOKEN=replace-with-a-local-only-bootstrap-secret
ALLOW_TEST_QR=true
ALLOW_REAL_QR=false
ALLOW_TEST_CONTEXT=false
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=
BACKEND_TIMEOUT_SECONDS=8
RESERVATION_DURATION_MINUTES=120

# ---------------------------------------------------------------------------
# Persistent Memory
# ---------------------------------------------------------------------------
# JARVIS uses a bounded, process-local MemorySaver in this local profile.
# It is intentionally not durable across restarts or workers. Replace the
# saver with a tenant-scoped persistent backend before shared deployment.
