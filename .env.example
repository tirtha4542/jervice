APP_NAME=Tavonza AI
APP_ENV=development
# Must use the asyncpg driver (postgresql+asyncpg://). A bare postgresql:// URL
# would require psycopg2, which is not installed in this project.
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/tavonza_local
GROQ_API_KEY=your_groq_api_key_here
# Must be a model your Groq key can access: https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
JARVIS_TEMPERATURE=0.2
